{
  "name": "crypto-agent-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Paper-trading AI agent loop for crypto, CLI only.",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "OPENROUTER_API_KEY=test tsx --test tests/*.test.ts",
    "journal": "tsx src/scripts/print-journal.ts",
    "stats": "tsx src/scripts/stats.ts",
    "pairs": "tsx src/scripts/select-pairs.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "ccxt": "^4.5.0",
    "dotenv": "^16.4.5",
    "ink": "^7.0.3",
    "openai": "^4.70.0",
    "react": "^18.3.1",
    "trading-signals": "^7.0.0",
    "winston": "^3.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
