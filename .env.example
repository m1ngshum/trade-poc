# Exchange (CCXT, public market data only — no key required)
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
CYCLE_INTERVAL_MIN=15

# LLM provider: "openrouter" or "claude-cli"
LLM_PROVIDER=openrouter

# --- when LLM_PROVIDER=openrouter ---
OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter model id, e.g. anthropic/claude-sonnet-4.6 (fall back to 4.5 if 4.6 unavailable)
LLM_MODEL=anthropic/claude-sonnet-4.6

# --- when LLM_PROVIDER=claude-cli ---
# Spawns the local `claude` CLI with --bare, which skips OAuth/keychain reads
# and ALWAYS bills against ANTHROPIC_API_KEY (Anthropic Console credits).
# Subscription (Pro/Max) auth is not supported by this path; Anthropic's
# policy disallows subscription-backed third-party agents.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=sonnet                       # CLI alias or full id like claude-sonnet-4-6
# LLM_FALLBACK_MODEL=claude-haiku-4-5    # used automatically if primary is overloaded
# CLAUDE_CLI_PATH=claude                 # only set if `claude` is not on PATH

SELF_CONSISTENCY_N=3

# Paper trading
INITIAL_EQUITY=10000
MAX_POSITION_PCT=20
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=15

# Misc
LOG_LEVEL=info
DB_PATH=./data/journal.db
