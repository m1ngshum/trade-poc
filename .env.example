# Exchange (CCXT, public market data only — no key required)
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
# Cycles fire on each TIMEFRAME close + a 5s buffer; no separate interval.
TIMEFRAME=15m

# LLM provider: "openrouter" | "claude-cli" | "claude-cli-oauth"
LLM_PROVIDER=openrouter

# --- when LLM_PROVIDER=openrouter ---
OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter model id, e.g. anthropic/claude-sonnet-4.6 (fall back to 4.5 if 4.6 unavailable)
LLM_MODEL=anthropic/claude-sonnet-4.6

# --- when LLM_PROVIDER=claude-cli (API key, sanctioned for automation) ---
# Spawns `claude -p --bare`, which skips OAuth/keychain and ALWAYS bills
# against ANTHROPIC_API_KEY (Anthropic Console credits).
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_MODEL=sonnet                       # CLI alias or full id like claude-sonnet-4-6
# LLM_FALLBACK_MODEL=claude-haiku-4-5    # used automatically if primary is overloaded
# CLAUDE_CLI_PATH=claude                 # only set if `claude` is not on PATH

# --- when LLM_PROVIDER=claude-cli-oauth (subscription, gray-area) ---
# Spawns `claude -p` (no --bare) so the CLI's logged-in OAuth (Pro/Max)
# is used. ANTHROPIC_API_KEY is NOT required — and is scrubbed from the
# subprocess env if set, so the CLI cannot fall through to API billing.
# Run `claude /status` once interactively to confirm you're signed in
# with your subscription. Anthropic does not officially support
# subscription-backed automated agents; rate limits are shared with
# claude.ai usage.
# LLM_MODEL=sonnet
# LLM_FALLBACK_MODEL=claude-haiku-4-5

SELF_CONSISTENCY_N=3

# Paper trading
INITIAL_EQUITY=10000
MAX_POSITION_PCT=20
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=15
# Risk engine rejects non-HOLD intents below this confidence (0..1).
# The system prompt instructs the LLM to HOLD if confidence < 0.6, but
# a misbehaving model can ignore that — the engine enforces it too.
MIN_CONFIDENCE=0.6
# Risk-per-trade as a % of equity. The risk engine sizes every accepted
# non-HOLD trade as min(RISK_PER_TRADE_PCT / stop_loss_pct * 100,
# MAX_POSITION_PCT). The LLM-proposed size is overridden — sizing is
# deterministic, not at the model's discretion.
RISK_PER_TRADE_PCT=0.5
# Hard daily cap on accumulated LLM API spend (USD, UTC midnight reset).
# Once exceeded, cycles short-circuit to synthetic HOLD without calling
# the LLM. Set to 0 to disable (not recommended).
LLM_DAILY_BUDGET_USD=5

# Misc
LOG_LEVEL=info
DB_PATH=./data/journal.db
