# Exchange (CCXT, public market data only — no key required)
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
CYCLE_INTERVAL_MIN=15

# LLM via OpenRouter (OpenAI-compatible API)
OPENROUTER_API_KEY=sk-or-v1-...
LLM_MODEL=anthropic/claude-sonnet-4.6
# Fall back to anthropic/claude-sonnet-4.5 if 4.6 is not yet on OpenRouter.
SELF_CONSISTENCY_N=3

# Paper trading
INITIAL_EQUITY=10000
MAX_POSITION_PCT=20
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=15

# Misc
LOG_LEVEL=info
DB_PATH=./data/journal.db
