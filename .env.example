# Exchange (CCXT, public market data only — no key required)
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=15m
CYCLE_INTERVAL_MIN=15

# LLM provider: "openrouter" or "claude-cli"
LLM_PROVIDER=openrouter

# --- when LLM_PROVIDER=openrouter ---
OPENROUTER_API_KEY=sk-or-v1-...
# OpenRouter model id, e.g. anthropic/claude-sonnet-4.6 (fall back to 4.5 if 4.6 unavailable)
LLM_MODEL=anthropic/claude-sonnet-4.6

# --- when LLM_PROVIDER=claude-cli ---
# Uses your local `claude` CLI auth (Pro/Max subscription or whatever it's signed in with).
# Override LLM_MODEL to a Claude CLI alias or full id, e.g. "sonnet" or "claude-sonnet-4-6".
# CLAUDE_CLI_PATH only needed if `claude` isn't on PATH.
# LLM_MODEL=sonnet
# CLAUDE_CLI_PATH=claude

SELF_CONSISTENCY_N=3

# Paper trading
INITIAL_EQUITY=10000
MAX_POSITION_PCT=20
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_PCT=15

# Misc
LOG_LEVEL=info
DB_PATH=./data/journal.db
